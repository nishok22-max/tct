# Cloudflare Pages / Netlify header rules (copied to dist/ as-is).
# Text assets (HTML, CSS, JS, SVG, XML) are compressed with Brotli/gzip automatically by both hosts.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Fingerprinted build output (JS, CSS, fonts, processed images): never changes under the same name.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Scroll-scrubbed film clips. Not fingerprinted: rename the file (e.g. -v2) when re-encoding.
# Byte-range requests are served by the host, so the browser fetches progressively.
/video/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800
  Accept-Ranges: bytes

# Icons and social image
/favicon.ico
  Cache-Control: public, max-age=604800
/favicon-32.png
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/icon-512.png
  Cache-Control: public, max-age=604800
/og.jpg
  Cache-Control: public, max-age=604800

# HTML: always revalidate so new deployments show immediately.
/
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate

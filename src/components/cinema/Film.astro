---
// Chapters 1–3 of the story: NATURE (scroll-scrubbed footage) → ORIGIN (live-action cotton field,
// wind in real time, camera pulling back, then zooming out into the next frame) → BLOOM (featured
// boll opening + macro footage). One pinned stage, so the shots can dissolve into each other.
//
// Without JS, or with prefers-reduced-motion, the same markup renders as three stacked,
// fully readable scenes (poster images, static canvas frame, all copy visible).
import { Picture, getImage } from 'astro:assets';
import { film } from '../../data/site';
import heroWide from '../../assets/film/hero-poster-wide.webp';
import heroTall from '../../assets/film/hero-poster-tall.webp';
import fieldWide from '../../assets/film/field-wind-poster-wide.webp';
import fieldTall from '../../assets/film/field-wind-poster-tall.webp';
import bokeh from '../../assets/film/field-bokeh.webp';
import macro from '../../assets/film/bloom-macro-wide.webp';
const h = film.hero;
// LCP image: AVIF first (≈⅓ the bytes of WebP), sized per viewport, portrait crop for phones.
const wideAvif = await Promise.all([640, 960, 1280].map((w) => getImage({ src: heroWide, width: w, format: 'avif', quality: 60 })));
const wideWebp = await Promise.all([640, 1280].map((w) => getImage({ src: heroWide, width: w, format: 'webp', quality: 72 })));
const tallAvif = await Promise.all([360, 540].map((w) => getImage({ src: heroTall, width: w, format: 'avif', quality: 60 })));
const srcset = (imgs: { src: string; options: { width?: number } }[]) => imgs.map((i) => `${i.src} ${i.options.width}w`).join(', ');
---
<section class="film" aria-label="The journey of cotton" data-film>
  <div class="film__stage" data-film-stage>

    <!-- 1 · NATURE ─ hero footage -->
    <div class="scene scene--hero" data-scene="hero">
      <span class="film__mark" id="top" data-mark="0"></span>
      <div class="scene__media" data-hero-media>
        <picture class="scene__poster">
          <source media="(max-aspect-ratio: 3/4)" type="image/avif" srcset={srcset(tallAvif)} sizes="100vw" />
          <source media="(max-aspect-ratio: 3/4)" srcset={heroTall.src} />
          <source type="image/avif" srcset={srcset(wideAvif)} sizes="100vw" />
          <source type="image/webp" srcset={srcset(wideWebp)} sizes="100vw" />
          <img src={wideWebp[1]!.src} width={heroWide.width} height={heroWide.height} alt={h.posterAlt} fetchpriority="high" decoding="async" />
        </picture>
        <video class="scene__video" muted playsinline preload="none" tabindex="-1" aria-hidden="true" disablepictureinpicture disableRemotePlayback
          data-film-video="hero" data-src-wide={film.video.hero.wide} data-src-tall={film.video.hero.tall}></video>
        <div class="scene__shade scene__shade--hero"></div>
      </div>
      <div class="container scene__copy scene__copy--hero" data-hero-copy>
        <p class="eyebrow eyebrow--light" data-reveal-hero style="--i:0">{h.eyebrow}</p>
        <h1 class="display">
          <span class="line"><span style="--i:1">{h.lines[0]}</span></span>
          <span class="line"><span style="--i:2"><em>{h.lines[1]}</em></span></span>
        </h1>
        <p class="scene__sub" data-reveal-hero style="--i:3">{h.sub}</p>
        <div class="scene__ctas" data-reveal-hero style="--i:4">
          <a class="btn btn--light" href={h.cta.href} data-film-jump>{h.cta.label}<span class="arrow" aria-hidden="true">↓</span></a>
          <a class="textlink textlink--light" href={h.skip.href}>{h.skip.label}</a>
        </div>
      </div>
      <div class="scroll-cue" aria-hidden="true" data-scroll-cue><span class="scroll-cue__line"></span><span class="scroll-cue__label">Scroll</span></div>
    </div>

    <!-- 2b · FOCUS ─ the frame the zoom-out reveals: real out-of-focus field + the featured
         cotton plant (AKRMillsCottonField engine, plant-only mode) whose boll opens with scroll -->
    <div class="scene scene--focus" data-scene="focus" aria-hidden="true">
      <div class="scene__media" data-focus-media>
        <Picture class="scene__poster focus__bokeh" src={bokeh} alt="" formats={['avif']} fallbackFormat="webp" widths={[640, 1280]} sizes="100vw" loading="lazy" decoding="async" data-focus-bokeh />
        <canvas class="field-canvas field-canvas--featured" data-featured-canvas aria-hidden="true"></canvas>
      </div>
    </div>

    <!-- 2 · ORIGIN ─ live-action cotton field in the wind -->
    <div class="scene scene--origin" data-scene="origin">
      <span class="film__mark" id="origin" data-mark="0.34"></span>
      <div class="scene__media" data-field-media>
        <div class="live-frame" data-live-frame>
          <picture class="scene__poster">
            <source media="(max-aspect-ratio: 3/4)" srcset={fieldTall.src} />
            <img src={fieldWide.src} width={fieldWide.width} height={fieldWide.height} alt={film.origin.posterAlt} loading="lazy" decoding="async" />
          </picture>
          <video class="scene__video" muted playsinline loop preload="none" tabindex="-1" aria-hidden="true" disablepictureinpicture disableRemotePlayback
            data-field-video data-src-wide={film.video.field.wide} data-src-tall={film.video.field.tall}></video>
          <div class="scene__shade scene__shade--origin"></div>
        </div>
      </div>
      <div class="container scene__copy scene__copy--origin" data-origin-copy>
        <p class="eyebrow eyebrow--light">{film.origin.eyebrow}</p>
        <h2 class="display display--lg">{film.origin.title}</h2>
        <p class="scene__sub">{film.origin.sub}</p>
      </div>
    </div>

    <!-- 3 · BLOOM ─ macro footage, revealed through the featured boll -->
    <div class="scene scene--bloom" data-scene="bloom">
      <span class="film__mark" id="bloom" data-mark="0.58"></span>
      <div class="scene__media" data-bloom-media>
        <Picture class="scene__poster" src={macro} alt={film.bloom.posterAlt} formats={['avif']} fallbackFormat="webp" widths={[640, 1280]} sizes="100vw" loading="lazy" decoding="async" />
        <video class="scene__video" muted playsinline preload="none" tabindex="-1" aria-hidden="true" disablepictureinpicture disableRemotePlayback
          data-film-video="bloom" data-src-wide={film.video.bloom.wide} data-src-tall={film.video.bloom.tall}></video>
        <div class="scene__shade scene__shade--bloom"></div>
      </div>
      <div class="container scene__copy scene__copy--bloom" data-bloom-copy>
        <p class="eyebrow eyebrow--light">{film.bloom.eyebrow}</p>
        <h2 class="display display--lg">{film.bloom.title}</h2>
      </div>
    </div>

    <!-- Transition elements (decorative) -->
    <div class="film__flare" aria-hidden="true" data-flare></div>
    <svg class="film__fibres" aria-hidden="true" focusable="false" data-fibres viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice">
      <defs>
        <radialGradient id="fibre-glow" cx="50%" cy="50%" r="50%">
          <stop offset="0" stop-color="#FFF8E8" />
          <stop offset="1" stop-color="#F3EBDD" stop-opacity="0" />
        </radialGradient>
      </defs>
      <circle cx="800" cy="450" r="520" fill="url(#fibre-glow)" data-fibre-core />
      <g fill="none" stroke="#FFFDF5" stroke-linecap="round" data-fibre-strands></g>
    </svg>
    <div class="film__wash" aria-hidden="true" data-wash></div>
  </div>
</section>

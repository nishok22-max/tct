---
// A small khadi charkha (spinning wheel) the visitor can turn. The wheel is dragged round (GSAP
// Draggable + inertia, see src/scripts/play/charkha.ts); the drive band turns the spindle ~8× faster,
// winding the cop. Keyboard: it is a slider — arrow keys turn it.
const C = { x: 118, y: 128, r: 92 };
const spokes = 8;
const rim = Array.from({ length: spokes * 2 }, (_, i) => {
  const a = (i / (spokes * 2)) * Math.PI * 2;
  const r = i % 2 ? C.r - 7 : C.r;
  return `${(C.x + Math.cos(a) * r).toFixed(1)},${(C.y + Math.sin(a) * r).toFixed(1)}`;
}).join(' ');
const spokeLines = Array.from({ length: spokes }, (_, i) => {
  const a = (i / spokes) * Math.PI * 2;
  return { x2: C.x + Math.cos(a) * (C.r - 4), y2: C.y + Math.sin(a) * (C.r - 4) };
});
const S = { x: 312, y: 150 }; // spindle whorl
---
<div class="charkha" data-charkha>
  <div class="charkha__stage" role="slider" tabindex="0" aria-label="Turn the khadi spinning wheel" aria-valuemin="0" aria-valuemax="359" aria-valuenow="0" aria-valuetext="0 degrees" data-charkha-handle>
    <svg viewBox="0 0 400 270" focusable="false" aria-hidden="true">
      <defs>
        <linearGradient id="ck-wood" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#A9804E" />
          <stop offset="1" stop-color="#7A5A34" />
        </linearGradient>
        <linearGradient id="ck-cop" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#FBF5EA" />
          <stop offset="1" stop-color="#D9C9A9" />
        </linearGradient>
        <clipPath id="ck-cop-clip"><ellipse cx={S.x + 38} cy={S.y} rx="26" ry="11" /></clipPath>
        <pattern id="ck-stripes" width="8" height="30" patternUnits="userSpaceOnUse" data-charkha-stripes>
          <rect width="8" height="30" fill="url(#ck-cop)" />
          <path d="M0 0 L4 30" stroke="#C9B68F" stroke-width="1.2" />
        </pattern>
      </defs>

      <!-- base plank and posts -->
      <rect x="14" y="236" width="372" height="16" rx="4" fill="url(#ck-wood)" />
      <path d={`M${C.x - 46} 236 L${C.x} ${C.y} L${C.x + 46} 236`} fill="none" stroke="#7A5A34" stroke-width="9" stroke-linecap="round" stroke-linejoin="round" />
      <path d={`M${S.x - 10} 236 L${S.x - 10} ${S.y + 6} M${S.x + 70} 236 L${S.x + 70} ${S.y + 6}`} stroke="#7A5A34" stroke-width="7" stroke-linecap="round" />

      <!-- drive band: wheel rim → spindle whorl -->
      <path d={`M${C.x} ${C.y - C.r} L${S.x} ${S.y - 6} M${C.x} ${C.y + C.r} L${S.x} ${S.y + 6}`} stroke="#C68F4C" stroke-width="1.4" />

      <!-- spindle with its cop of yarn (stripes move as it turns) -->
      <g data-charkha-spindle>
        <line x1={S.x - 6} y1={S.y} x2={S.x + 92} y2={S.y} stroke="#5B5B52" stroke-width="2.4" stroke-linecap="round" />
        <circle cx={S.x} cy={S.y} r="7" fill="#7A5A34" />
        <ellipse cx={S.x + 38} cy={S.y} rx="26" ry="11" fill="url(#ck-stripes)" />
        <ellipse cx={S.x + 38} cy={S.y} rx="26" ry="11" fill="none" stroke="#B8A47E" stroke-width="0.8" />
      </g>
      <!-- the thread drawn off the spindle tip -->
      <path d={`M${S.x + 92} ${S.y} Q ${S.x + 96} ${S.y - 40} ${S.x + 84} ${S.y - 92}`} fill="none" stroke="#E9D8BA" stroke-width="1.3" data-charkha-thread />

      <!-- the wheel (rotates) -->
      <g class="charkha__wheel" data-charkha-wheel>
        <circle cx={C.x} cy={C.y} r={C.r + 10} fill="transparent" />
        {spokeLines.map((s) => <line x1={C.x} y1={C.y} x2={s.x2} y2={s.y2} stroke="url(#ck-wood)" stroke-width="5" stroke-linecap="round" />)}
        <polygon points={rim} fill="none" stroke="#E9D8BA" stroke-width="1.6" stroke-linejoin="round" />
        <circle cx={C.x} cy={C.y} r={C.r} fill="none" stroke="#8A6A3E" stroke-width="3" />
        <circle cx={C.x} cy={C.y} r="13" fill="#7A5A34" />
        <circle cx={C.x} cy={C.y} r="5" fill="#C68F4C" />
        <!-- crank handle -->
        <line x1={C.x} y1={C.y} x2={C.x + 34} y2={C.y + 30} stroke="#5B4326" stroke-width="5" stroke-linecap="round" />
        <circle cx={C.x + 34} cy={C.y + 30} r="6.5" fill="#C68F4C" stroke="#5B4326" stroke-width="2" />
      </g>
    </svg>

    <!-- hand-drawn hint -->
    <svg class="charkha__hint" viewBox="0 0 400 270" focusable="false" aria-hidden="true">
      <path class="hand-arrow" pathLength="1" d={`M${C.x - 86} ${C.y - 64} C ${C.x - 70} ${C.y - 132}, ${C.x + 60} ${C.y - 140}, ${C.x + 98} ${C.y - 74}`} />
      <path class="hand-arrow hand-arrow--head" pathLength="1" d={`M${C.x + 80} ${C.y - 84} L ${C.x + 99} ${C.y - 72} L ${C.x + 104} ${C.y - 95}`} />
    </svg>
    <p class="hand-note charkha__note" aria-hidden="true">turn this side</p>
  </div>
</div>

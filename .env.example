# Where the enquiry form POSTs FormData. The live Cloudflare setup exposes /api/enquiry.
PUBLIC_ENQUIRY_ENDPOINT=/api/enquiry
# Optional Cloudflare Turnstile site key (leave empty to disable the widget).
PUBLIC_TURNSTILE_SITEKEY=
# Optional Google Tag Manager container (off when empty). Live site uses GTM-W4BVFWGN.
PUBLIC_GTM_ID=
